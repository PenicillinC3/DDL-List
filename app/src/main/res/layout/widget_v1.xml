<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2「最近到期」单焦点卡（装饰：右上角台历红签 + 底部周尺）。
     颜色为占位值，运行时随夜模式由 DdlWidgets 重设；西文×思源混排由代码 TypefaceSpan 完成（API≥28）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="11dp"
        android:paddingEnd="17dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近到期"
            android:textColor="#FF5F6771"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:fontFamily="@font/source_han_cn_600" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="48dp"
            android:text="--"
            android:textColor="#FF101828"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/source_han_cn_600" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="1dp"
            android:text="剩--"
            android:textColor="#FF101828"
            android:textSize="26sp"
            android:maxLines="1"
            android:letterSpacing="0.01"
            android:fontFamily="@font/maple_mono_bold_data" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FF5F6771"
            android:textSize="11.5sp"
            android:letterSpacing="0.02"
            android:fontFamily="@font/timeless_serif_text" />

        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="--"
            android:textColor="#FF5F6771"
            android:textSize="11sp"
            android:fontFamily="@font/source_han_cn_400" />

        <!-- S2 周尺：7 段刻度 + 燃线进程 -->
        <FrameLayout
            android:id="@+id/widget_ruler"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>
            </LinearLayout>

            <View
                android:id="@+id/widget_ruler_track"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_gravity="bottom"
                android:background="@drawable/widget_ruler_track_light" />

            <ProgressBar
                android:id="@+id/widget_ruler_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="168"
                android:progress="40"
                android:progressDrawable="@drawable/widget_ruler_progress" />
        </FrameLayout>
    </LinearLayout>

    <!-- S1 台历红签（挂顶边垂下的迷你日历页） -->
    <LinearLayout
        android:id="@+id/widget_calpg"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/widget_calpg_light"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_calpg_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10月"
            android:textColor="#FFFFFFFF"
            android:textSize="7.5sp"
            android:letterSpacing="0.08"
            android:fontFamily="@font/source_han_cn_600" />

        <TextView
            android:id="@+id/widget_calpg_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/timeless_serif_text" />
    </LinearLayout>
</FrameLayout>
