<?xml version="1.0" encoding="utf-8"?>
<!-- V1 单焦点卡 选择器封面（initialLayout/previewLayout）：带真实示例数据，一眼认出款式。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="11dp"
        android:paddingEnd="17dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wgt_header_recent"
            android:textColor="#FF5F6771"
            android:textSize="10sp"
            android:letterSpacing="0.14"
/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="48dp"
            android:text="@string/pv_title_thesis"
            android:textColor="#FF101828"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="1dp"
            android:text="@string/pv_cd_days"
            android:textColor="#FF101828"
            android:textSize="26sp"
            android:maxLines="1"
            android:letterSpacing="0.01"
/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pv_abs_line"
            android:textColor="#FF5F6771"
            android:textSize="11.5sp"
            android:letterSpacing="0.02"
/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/pv_meta"
            android:textColor="#FF5F6771"
            android:textSize="11sp"
/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="4dp"
                        android:layout_gravity="left|top"
                        android:background="@drawable/widget_tick" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_gravity="bottom"
                android:background="@drawable/widget_ruler_track_light" />

            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:max="168"
                android:progress="40"
                android:progressDrawable="@drawable/widget_ruler_progress" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/widget_calpg_light"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ph_calpg_month"
            android:textColor="#FFFFFFFF"
            android:textSize="7.5sp"
            android:letterSpacing="0.08"
/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
/>
    </LinearLayout>
</FrameLayout>
