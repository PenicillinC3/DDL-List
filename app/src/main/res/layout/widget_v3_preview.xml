<?xml version="1.0" encoding="utf-8"?>
<!-- V3 多行卡 选择器封面（initialLayout/previewLayout）：三条 + 行内燃线 + 周多点条示例。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="11dp"
        android:paddingEnd="17dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/wgt_header_recent"
            android:textColor="#FF5F6771"
            android:textSize="10sp"
            android:letterSpacing="0.14"
/>

        <!-- 行 1：今日急迫 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pv_title_rehearsal"
                    android:textColor="#FF101828"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/pv_cd_hours"
                    android:textColor="#FFE5484D"
                    android:textSize="12sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/widget_ruler_track_light" />

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progress="92"
                    android:progressDrawable="@drawable/widget_ruler_progress" />
            </FrameLayout>
        </LinearLayout>

        <!-- 行 2：周内 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pv_title_thesis"
                    android:textColor="#FF101828"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/pv_cd_days"
                    android:textColor="#FF101828"
                    android:textSize="12sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/widget_ruler_track_light" />

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progress="42"
                    android:progressDrawable="@drawable/widget_ruler_progress" />
            </FrameLayout>
        </LinearLayout>

        <!-- 行 3：稍后（窗外，无燃线） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pv_title_english_corner"
                    android:textColor="#FF101828"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/pv_cd_week"
                    android:textColor="#FF101828"
                    android:textSize="12sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/widget_ruler_track_light" />
            </FrameLayout>
        </LinearLayout>

        <!-- 周多点条（演示：今日 2 条、周三、周五） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_today_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekday_narrow_0"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_red_soft" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekday_narrow_1"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekday_narrow_2"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekday_narrow_3"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekday_narrow_4"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekday_narrow_5"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekday_narrow_6"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/widget_calpg_light"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ph_calpg_month"
            android:textColor="#FFFFFFFF"
            android:textSize="7sp"
            android:letterSpacing="0.08"
/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
/>
    </LinearLayout>
</FrameLayout>
