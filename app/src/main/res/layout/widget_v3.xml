<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2「最近到期」多行卡（装饰：右上角台历红签 + 每行燃线 + 底部周多点条）。
     颜色为占位值，运行时由 DdlWidgets 重设；行 3 视数据显隐。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="9dp"
        android:paddingEnd="17dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近到期"
            android:textColor="#FF5F6771"
            android:textSize="10sp"
            android:letterSpacing="0.14"
/>

        <!-- 行 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_row1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="#FF101828"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:id="@+id/widget_row1_cd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="剩--"
                    android:textColor="#FF101828"
                    android:textSize="13sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_row1_fuse"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="2dp"
                android:max="100"
                android:progress="10"
                android:progressDrawable="@drawable/widget_ruler_progress" />
        </LinearLayout>

        <!-- 行 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_row2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="#FF101828"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:id="@+id/widget_row2_cd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="剩--"
                    android:textColor="#FF101828"
                    android:textSize="13sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_row2_fuse"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="2dp"
                android:max="100"
                android:progress="10"
                android:progressDrawable="@drawable/widget_ruler_progress" />
        </LinearLayout>

        <!-- 行 3（不足三条时整行隐藏） -->
        <LinearLayout
            android:id="@+id/widget_row3_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_row3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="#FF101828"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:id="@+id/widget_row3_cd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="剩--"
                    android:textColor="#FF101828"
                    android:textSize="13sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_row3_fuse"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="2dp"
                android:max="100"
                android:progress="10"
                android:progressDrawable="@drawable/widget_ruler_progress" />
        </LinearLayout>

        <!-- M5 周多点条：7 格，每格「星期字 + 至多 2 点」 -->
        <LinearLayout
            android:id="@+id/widget_week_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_week_cell0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_today_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_week_day0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="一"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_week_dot0_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_red" />

                    <View
                        android:id="@+id/widget_week_dot0_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_red_soft" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_week_day1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="二"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_week_dot1_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/widget_week_dot1_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_week_day2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="三"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_week_dot2_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/widget_week_dot2_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_week_day3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="四"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_week_dot3_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/widget_week_dot3_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_week_day4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="五"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_week_dot4_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/widget_week_dot4_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_week_day5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="六"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_week_dot5_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/widget_week_dot5_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_week_day6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/widget_week_dot6_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/widget_week_dot6_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- S1 台历红签 -->
    <LinearLayout
        android:id="@+id/widget_calpg"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/widget_calpg_light"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_calpg_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10月"
            android:textColor="#FFFFFFFF"
            android:textSize="7.5sp"
            android:letterSpacing="0.08"
/>

        <TextView
            android:id="@+id/widget_calpg_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
/>
    </LinearLayout>
</FrameLayout>
