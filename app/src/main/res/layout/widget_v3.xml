<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2「最近到期」多行卡（装饰：右上角台历红签 + 每行燃线 + 底部周多点条）。
     颜色为占位值，运行时由 DdlWidgets 重设；行 3 视数据显隐。
     ⚠️ 装饰条全部用 TextView：裸 <View> 不在 RemoteViews 白名单，启动器 apply 即报
     「Class not allowed to be inflated」并吞成错误视图（1.13 根因，勿回退）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="11dp"
        android:paddingEnd="17dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="最近到期"
            android:textColor="#FF5F6771"
            android:textSize="10sp"
            android:letterSpacing="0.14"
/>

        <!-- 弹性隙 1：header ↔ 行 1（0.30 权重＝v1.15.1 头隙再让量，两刀经验法 0.66→0.40→0.30，
             行块重心微升；8dp 保底 = 台历红签领地，勿减） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.30" />

        <!-- 行 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_row1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="#FF101828"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:id="@+id/widget_row1_cd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="剩--"
                    android:textColor="#FF101828"
                    android:textSize="12sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <!-- 行内燃线淡轨（低进度才有「这里有个刻度」的锚点）；日夜分色运行时由 DdlWidgets 重设 -->
                <TextView
                    android:id="@+id/widget_row1_track"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/widget_ruler_track_light" />

                <ProgressBar
                    android:id="@+id/widget_row1_fuse"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progress="10"
                    android:progressDrawable="@drawable/widget_ruler_progress" />
            </FrameLayout>
        </LinearLayout>

        <!-- 弹性隙 2：行 1 ↔ 行 2（均分呼吸） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 行 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_row2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="#FF101828"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:id="@+id/widget_row2_cd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="剩--"
                    android:textColor="#FF101828"
                    android:textSize="12sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_row2_track"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/widget_ruler_track_light" />

                <ProgressBar
                    android:id="@+id/widget_row2_fuse"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progress="10"
                    android:progressDrawable="@drawable/widget_ruler_progress" />
            </FrameLayout>
        </LinearLayout>

        <!-- 弹性隙 3：行 2 ↔ 行 3（随行 3 一起显隐，行 3 不在场时不占隙） -->
        <TextView
            android:id="@+id/widget_gap_row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 行 3（不足三条时整行隐藏） -->
        <LinearLayout
            android:id="@+id/widget_row3_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_row3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="#FF101828"
                    android:textSize="15sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
/>

                <TextView
                    android:id="@+id/widget_row3_cd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="剩--"
                    android:textColor="#FF101828"
                    android:textSize="12sp"
                    android:maxLines="1"
/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_row3_track"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@drawable/widget_ruler_track_light" />

                <ProgressBar
                    android:id="@+id/widget_row3_fuse"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progress="10"
                    android:progressDrawable="@drawable/widget_ruler_progress" />
            </FrameLayout>
        </LinearLayout>

        <!-- 弹性隙 4：末行 ↔ 周多点条（1.70 权重＝v1.15.1 承接隙 1 让出的量；配合周条
             marginTop 8dp，上让下收，行块重心升约 3-4dp；五隙总重恒 5.0，隙 2/3/5 份额不变） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.70" />

        <!-- M5 周多点条：7 格，每格「星期字 + 至多 2 点」 -->
        <LinearLayout
            android:id="@+id/widget_week_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_week_cell0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_today_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_week_day0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="一"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_week_dot0_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/widget_week_dot0_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_red_soft" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_week_day1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="二"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_week_dot1_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_week_dot1_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_week_day2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="三"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_week_dot2_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_week_dot2_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_week_day3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="四"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_week_dot3_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_week_dot3_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_week_day4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="五"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_week_dot4_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_week_dot4_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_week_day5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="六"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_week_dot5_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_week_dot5_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_week_cell6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_light"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_week_day6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日"
                    android:textColor="#FF5F6771"
                    android:textSize="8.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_week_dot6_a"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_week_dot6_b"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/dot_ind_light"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 弹性隙 5：周多点条 ↔ 底边（拉高时与其他隙均分，周条不再钉底） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- S1 台历红签（收短版：总高≈31dp，header 保底隙 8dp 即可让出行 1） -->
    <LinearLayout
        android:id="@+id/widget_calpg"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="18dp"
        android:background="@drawable/widget_calpg_light"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_calpg_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10月"
            android:textColor="#FFFFFFFF"
            android:textSize="7sp"
            android:letterSpacing="0.08"
/>

        <TextView
            android:id="@+id/widget_calpg_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
/>
    </LinearLayout>
</FrameLayout>
